{
  "$schema": "vscode://schemas/color-theme",
  "name": "Oni Coral",
  "semanticHighlighting": true,
  "colors": {
    // ========== PRIMARY / ACCENT (néon — spécifique à la variante) ==========
    "activityBar.activeBackground": "#ff6b5326",
    "activityBar.activeBorder": "#ff6b53",
    "activityBar.foreground": "#ff6b53",
    "activityBarBadge.background": "#ff6b53",
    "activityBarBadge.foreground": "#18161f",

    "badge.background": "#ff6b53",
    "badge.foreground": "#18161f",

    "button.background": "#ff6b5380",
    "button.foreground": "#ffd4cc",
    "button.hoverBackground": "#ff6b5399",

    "editor.selectionBackground": "#ff6b534d",
    "editor.inactiveSelectionBackground": "#ff6b5330",
    "editor.selectionHighlightBackground": "#ff6b5314",
    "editor.findMatchBackground": "#ff6b5330",
    "editor.findMatchBorder": "#ff6b5361",
    "editor.lineHighlightBackground": "#ff6b530a",
    "editor.wordHighlightBackground": "#ff6b5340",
    "editorCursor.foreground": "#ff6b53",
    "editorLineNumber.activeForeground": "#ff6b53",

    "focusBorder": "#ff6b53",
    "inputOption.activeBorder": "#ff6b53",

    "list.activeSelectionBackground": "#ff6b5340",
    "list.inactiveSelectionBackground": "#ff6b5326",
    "list.hoverBackground": "#ff6b531a",
    "list.focusBackground": "#ff6b5340",
    "list.dropBackground": "#ff6b5315",

    "panelTitle.activeBorder": "#ff6b53",
    "panelTitle.activeForeground": "#ff6b53",

    "progressBar.background": "#ff6b53",

    "sideBarSectionHeader.foreground": "#ff6b53",

    "statusBarItem.remoteBackground": "#ff6b53",
    "statusBarItem.remoteForeground": "#1c1a24",
    "statusBarItem.prominentBackground": "#ff6b53",
    "statusBarItem.prominentForeground": "#1c1a24",

    "tab.activeBorder": "#ff6b53",
    "tab.activeBorderTop": "#ff6b53",

    "terminal.ansiGreen": "#ff6b53",
    "terminal.ansiBrightGreen": "#ff8f7a",

    "selection.background": "#ff6b5361",
    "sash.hoverBorder": "#ff6b5350",

    // ========== BASE / NEUTRALS — Oni Dusk (noir pastel mauve) ==========
    "activityBar.background": "#18161f",
    "activityBar.border": "#14121a",
    "activityBar.inactiveForeground": "#8a8496",

    "button.secondaryBackground": "#2a2733",
    "button.secondaryForeground": "#cfcad8",

    "editor.background": "#1c1a24",
    "editor.foreground": "#e8e4ef",
    "editorCursor.background": "#1c1a24",
    "editorLineNumber.foreground": "#8a8496",
    "editorIndentGuide.background": "#2e2b38",
    "editorIndentGuide.activeBackground": "#3d3948",

    "editorGroupHeader.tabsBackground": "#18161f",
    "editorGroup.border": "#14121a",

    "foreground": "#e8e4ef",

    "input.background": "#22202b",
    "input.border": "#3d3948",
    "input.foreground": "#e8e4ef",

    "list.activeSelectionForeground": "#f2eff7",

    "panel.background": "#18161f",
    "panel.border": "#14121a",
    "panelTitle.inactiveForeground": "#8a8496",

    "sideBar.background": "#1c1a24",
    "sideBar.border": "#14121a",
    "sideBar.foreground": "#cfcad8",
    "sideBarSectionHeader.background": "#18161f",
    "sideBarTitle.foreground": "#f2eff7",

    "statusBar.background": "#18161f",
    "statusBar.foreground": "#cfcad8",
    "statusBar.border": "#14121a",

    "tab.activeBackground": "#1c1a24",
    "tab.activeForeground": "#f2eff7",
    "tab.inactiveBackground": "#18161f",
    "tab.inactiveForeground": "#8a8496",
    "tab.border": "#14121a",

    "terminal.background": "#18161f",
    "terminal.foreground": "#e8e4ef",

    "titleBar.activeBackground": "#1c1a24",
    "titleBar.activeForeground": "#f2eff7",
    "titleBar.inactiveBackground": "#1c1a24",
    "titleBar.inactiveForeground": "#8a8496"
  },
  "tokenColors": [
    // ========== SYNTAX — gems néon, teintées vers l'accent de la variante ==========
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8a8496", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#4dffb0" } },
    { "scope": ["keyword", "storage", "keyword.control"], "settings": { "foreground": "#ffcc44" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#4dd4ff" } },
    { "scope": ["variable", "variable.other", "variable.parameter"], "settings": { "foreground": "#ff6b53" } },
    { "scope": ["entity.name.class", "entity.name.type", "support.type", "support.class"], "settings": { "foreground": "#b88aff" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#ff8a40" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#ff7ac8" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#8a8496" } },
    { "scope": ["support.constant.property-value", "constant.other.color"], "settings": { "foreground": "#4dffb0" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#ff6b53", "fontStyle": "bold" } }
  ]
}
